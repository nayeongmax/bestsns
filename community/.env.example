# ============================================
# 커뮤니티 플랫폼 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
# ============================================

# Supabase 를 채우면 여러 사용자가 공유하는 실제 백엔드로 동작합니다.
# 비워두면 브라우저 localStorage 기반 데모 모드로 완전 동작합니다.
# Supabase 대시보드 > Settings > API
# VITE_SUPABASE_URL=https://xxxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
